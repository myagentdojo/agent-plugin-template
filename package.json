{
  "name": "agent-plugin-template-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "init": "bun run scripts/init.ts",
    "generate": "bun run scripts/generate.ts",
    "generate:check": "bun run scripts/generate.ts --check",
    "release:validate": "bun run scripts/release-validate.ts",
    "build": "bun run generate:check && bun run scripts/build.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:claude": "bun run scripts/dev.ts claude",
    "dev:codex": "bun run scripts/dev.ts codex",
    "ship:canary": "bun run scripts/ship-canary.ts",
    "readiness": "bun run scripts/repository-readiness.ts",
    "package": "bun run build && bun run scripts/package.ts",
    "prove:distribution": "bun run scripts/prove-distribution.ts",
    "prove:dx": "bun run scripts/prove-dx.ts",
    "prove:quickjs-ci": "bun run scripts/prove-quickjs-ci.ts",
    "prove:all": "bun test && bun run generate:check && bun run release:validate && bun run prove:quickjs-ci && bun run prove:dx",
    "spike:quickjs": "bun run scripts/quickjs-spike.ts",
    "spike:quickjs:ci": "bun run scripts/quickjs-spike.ts --ci"
  }
}
