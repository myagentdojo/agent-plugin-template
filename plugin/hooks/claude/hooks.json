{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/hello-world\" hook --harness claude --event SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/bin/hello-world\" hook --harness claude --event Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
